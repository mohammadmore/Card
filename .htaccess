# جلوگیری از نمایش فهرست فایل‌ها
Options -Indexes

# مسدود کردن فایل‌های حساس (کانفیگ، لاگ، سورس، ابزارها)
<FilesMatch "(^config(\.sample)?\.php$|\.log$|^error_log$|\.md$|\.sql$|^package(-lock)?\.json$|^build\.mjs$|^tailwind\.config\.js$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^(src|tools|node_modules)(/|$) - [F,L]

    # لینک کوتاه سازمان‌ها: /superadmin/acme → index.html (برنامه آدرس را از مسیر می‌خواند)
    RewriteRule ^__rewrite_ping$ api.php?action=ping [L,QSA]
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]/$ %1 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
