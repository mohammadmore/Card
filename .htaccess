# جلوگیری از نمایش فهرست فایل‌ها
Options -Indexes

# صفحه‌ی اصلی: صفحه‌ی معرفی (landing.php). برنامه (پنل‌ها و درگاه سازمان‌ها) همان index.html است.
DirectoryIndex landing.php index.html

# مسدود کردن فایل‌های حساس (کانفیگ، لاگ، سورس، ابزارها)
<FilesMatch "(^config(\.sample)?\.php$|\.log$|^error_log$|\.md$|\.sql$|^package(-lock)?\.json$|^build\.mjs$|^tailwind(\.landing)?\.config\.js$|^commerce\.php$|^landing_defaults\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^(src|tools|node_modules)(/|$) - [F,L]

    # لینک کوتاه سازمان‌ها: /superadmin/acme → index.html (برنامه آدرس را از مسیر می‌خواند)
    RewriteRule ^__rewrite_ping$ api.php?action=ping [L,QSA]

    # صفحه‌ی معرفی (فارسی و انگلیسی) و صفحه‌های قوانین، حریم خصوصی و تماس
    RewriteRule ^en/?$ landing.php?lang=en [L,QSA]
    RewriteRule ^en/(terms|privacy|contact)/?$ landing.php?page=$1&lang=en [L,QSA]
    RewriteRule ^(terms|privacy|contact)/?$ landing.php?page=$1 [L,QSA]
    RewriteRule ^sitemap\.xml$ landing.php?page=sitemap [L]
    # ورود سوپرادمین، سفارش آنلاین و پیگیری سفارش (داخل برنامه)
    RewriteRule ^(admin|order|track)/?$ index.html [L]
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]/$ %1 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$ index.html [L]
</IfModule>

# فشرده‌سازی (gzip): حجم دانلود صفحه را حدود یک‌سوم می‌کند. اگر ماژول روی هاست نباشد، این بخش بی‌اثر است و خطا نمی‌دهد.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# کش مرورگر: فایل‌های js/css نشانی نسخه‌دار دارند (?v=...) پس تا یک سال کش می‌شوند و بعد از هر به‌روزرسانی نسخه‌ی تازه دریافت می‌شود.
# index.html همیشه از سرور بررسی می‌شود تا نشانی نسخه‌های جدید را بگیرد.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|svg|ttf|otf|woff)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^(index\.html)?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # دسترسی به دوربین فقط برای خود سایت (گرفتن عکس کارت)؛ بقیه‌ی قابلیت‌های حساس بسته است
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
    # HSTS فقط روی HTTPS ارسال می‌شود (Apache 2.4)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    # CSP برنامه‌ی اصلی (index.html). اسکریپت درون‌خطی تم با هش مجاز است؛ اگر آن را عوض کردید هش را به‌روز کنید:
    #   php -r "echo base64_encode(hash('sha256', 'محتوای اسکریپت', true));"
    <FilesMatch "^index\.html$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-i6pl5gRC7+mfB/touoS8daNHHar8p5GiZo0hhPFK7e0='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' blob: data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>
